# NailMeasure runs fully in local mode (browser IndexedDB) when these are unset.
# Set all three to enable Supabase authentication, cloud persistence and private image storage.

# Public: project URL and anon (publishable) key. Safe to expose; access is enforced by RLS.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER ONLY. Used by API routes to write server-recomputed measurements after verifying
# the caller's session. Never prefix with NEXT_PUBLIC_ and never import from client code.
SUPABASE_SERVICE_ROLE_KEY=
